<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>FileDedupTool</AssemblyName>
    <RootNamespace></RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>True</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0162;CS0168;CS0169;CS0219;CS0414;CS0649;CS0659;CS0660;CS0661;CS1998;CS1717;CS8509;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8765;SYSLIB0011;SYSLIB0021;SYSLIB0022;SYSLIB0023</NoWarn>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="FileDedupTool.app.ico" />
    <None Remove="FileDedupTool.tray.ico" />
    <None Remove="FileDedupTool.help.zh.md" />
    <None Remove="FileDedupTool.help.en.md" />
    <EmbeddedResource Include="FileDedupTool.app.ico" LogicalName="FileDedupTool.app.ico" />
    <EmbeddedResource Include="FileDedupTool.tray.ico" LogicalName="FileDedupTool.tray.ico" />
    <!-- WithCulture=false：文件名里的 zh/en 会被 SDK 推断成附属程序集文化，导致资源不进主程序集，
         完整性自检会报“资源缺失”并判为未授权。这里固定嵌入主程序集。 -->
    <EmbeddedResource Include="FileDedupTool.help.zh.md" LogicalName="FileDedupTool.help.zh.md" WithCulture="false" />
    <EmbeddedResource Include="FileDedupTool.help.en.md" LogicalName="FileDedupTool.help.en.md" WithCulture="false" />
  </ItemGroup>

</Project>
